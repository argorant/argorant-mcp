{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "argorant": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.1.49",
        "https://mcp.argorant.com/mcp",
        "--transport",
        "http-only",
        "--static-oauth-client-metadata",
        "{\"client_name\":\"Hermes Agent\",\"token_endpoint_auth_method\":\"none\",\"grant_types\":[\"authorization_code\",\"refresh_token\"],\"response_types\":[\"code\"]}"
      ]
    }
  }
}
